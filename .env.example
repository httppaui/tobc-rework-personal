# API (server/)
JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SAME_SITE=lax
DATABASE_PATH=./data/tobc.db

# Production cross-origin (frontend on Vercel, API on separate host):
# CLIENT_ORIGIN=https://your-app.vercel.app
# COOKIE_SAME_SITE=none

# Frontend — leave empty in dev (Vite proxies /api to :3001)
# VITE_API_URL=https://your-api.example.com

# Sign-in on production (default off until API is wired). Dev always has auth.
# VITE_AUTH_ENABLED=true
